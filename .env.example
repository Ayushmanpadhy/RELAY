# Relay Environment Configuration

# Server listen port (default: 4000)
PORT=4000

# Server listen host (default: 0.0.0.0 for containers/cloud, localhost for local)
HOST=0.0.0.0

# Node environment (development | production)
NODE_ENV=production

# Persistent storage directory for SQLite database (default: ./data)
DATA_DIR=./data

# Coordinator internal URL for worker communication (optional, defaults to 127.0.0.1:$PORT)
COORDINATOR_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------
# AI Provider Configuration
# ---------------------------------------------------------------------

# Google Gemini API Key (Recommended, Free tier available)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Models (default: gemini-2.0-flash)
RELAY_PLANNER_MODEL=gemini-2.0-flash
RELAY_WORKER_MODEL=gemini-2.0-flash

# Alternative: Anthropic Claude (if not using Gemini)
# ANTHROPIC_API_KEY=

# Deterministic Simulation Mode (set to 1 to run offline with zero cost and no API keys)
# RELAY_FAKE_LLM=1
